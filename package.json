    "@mui/material": "7.3.2",
    "date-fns": "4.1.0",
    "i18next": "25.5.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "15.7.3",
    "react-router-dom": "7.9.1"
  },
  "devDependencies": {
    "@gen-epix/eslint-config": "0.0.20",
    "@gen-epix/typescript-config": "0.0.6",
    "@gen-epix/generate-license-manifest": "0.0.4",
    "@gen-epix/oidc-mock-server": "0.0.4",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/node": "24.5.1",
    "@vitejs/plugin-react-swc": "4.1.0",
    "eslint": "9.35.0",
    "nodemon": "3.1.10",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vite-plugin-svgr": "4.5.0",
    "vitest": "3.2.4"
  },
  "browserslist": [
    "last 2 Chrome versions"
  ]
